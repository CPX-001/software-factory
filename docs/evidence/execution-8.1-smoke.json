          "changes": [
            {
              "content": "import math\n\nfrom record_rules import normalized_category\n\n\ndef summarize(records):\n    \"\"\"Return validated whole-list and canonical-category record aggregates.\"\"\"\n    if not isinstance(records, list):\n        raise ValueError(\"records must be a list\")\n\n    total = 0\n    by_category = {}\n\n    for row in records:\n        if not isinstance(row, dict):\n            raise ValueError(\"each record must be a dictionary\")\n        if \"amount\" not in row or \"category\" not in row:\n            raise ValueError(\"each record must include amount and category\")\n\n        amount = row[\"amount\"]\n        if (isinstance(amount, bool) or not isinstance(amount, (int, float))\n                or not math.isfinite(amount) or amount < 0):\n            raise ValueError(\"amount must be a finite nonnegative number\")\n\n        try:\n            category = normalized_category(row[\"category\"])\n        except (TypeError, ValueError):\n            raise ValueError(\"category must be valid\") from None\n\n        total += amount\n        category_summary = by_category.setdefault(category, {\"count\": 0, \"total\": 0})\n        category_summary[\"count\"] += 1\n        category_summary[\"total\"] += amount\n\n    return {\"count\": len(records), \"total\": total, \"by_category\": by_category}\n",
              "operation": "write",
              "path": "records.py"
            }
          ],
          "checks_declared": [
